@ __config _INTRC_OSC_NOCLKOUT & _WDT_OFF & _LVP_OFF & _CP_ON & _PWRTE_ON & _MCLRE_ON & _BODEN_OFF
DEFINE OSC 4
DEFINE INTHAND TIMER_ISR

CMCON      = 7
OPTION_REG = %00001000

TRISA = %10111111
TRISB = %01000000

WSAVE VAR BYTE $20 SYSTEM
SSAVE VAR BYTE $21 SYSTEM

BILGI  VAR BYTE
BILGI  = 0
DURUM  VAR BYTE
DURUM  = 0

PORTA = 0
PORTB = 0

TMR0   = 166
INTCON = %10100000

BASLA:
    COUNT   PORTB.7, 15, BILGI
    DURUM   = (BILGI >= 85)
    PORTB.0 = DURUM
GOTO BASLA

ASM
TIMER_ISR:
    MOVWF   WSAVE
    SWAPF   STATUS, W
    CLRF    STATUS
    MOVWF   SSAVE
    MOVLW   .166
    MOVWF   TMR0
    MOVLW   b'01000000'
    XORWF   PORTA, F
    BCF     INTCON, T0IF
    SWAPF   SSAVE, W
    MOVWF   STATUS
    SWAPF   WSAVE, F
    SWAPF   WSAVE, W
    RETFIE
ENDASM
END
