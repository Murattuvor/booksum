@ __config _INTRC_OSC_NOCLKOUT & _WDT_OFF & _LVP_OFF & _CP_OFF & _PWRTE_ON & _MCLRE_ON & _BODEN_OFF

DEFINE OSC 4

CMCON = 7
OPTION_REG = %00000000

TRISA = %10111111
TRISB = %01000000

PORTA = 0
PORTB = 0

PERIYOT VAR WORD
FREKANS VAR WORD
DURUM   VAR BYTE

BASLA:

    PERIYOT = 5551

    ' 5551 / 65 = 85
    FREKANS = PERIYOT / 65

    DURUM = (FREKANS > 84) * (FREKANS < 86)

    PORTB.0 = DURUM

GOTO BASLA
END
